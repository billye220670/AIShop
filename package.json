{
  "name": "aishop",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "build": {
    "appId": "com.portai.app",
    "productName": "PortAI",
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "Icon/icon-256.png",
      "target": [
        "nsis"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "billye220670",
        "repo": "AIShop"
      }
    ],
    "extraResources": [
      {
        "from": "Icon",
        "to": "Icon",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:electron": "electron-vite dev",
    "build:electron": "electron-vite build",
    "preview:electron": "electron-vite preview",
    "package:win": "powershell -ExecutionPolicy Bypass -File pack-win.ps1",
    "package:win:skip-build": "powershell -ExecutionPolicy Bypass -File pack-win.ps1 -SkipBuild"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@capawesome/capacitor-file-picker": "^8.0.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-virtual": "^3.14.10",
    "electron-updater": "^6.8.3",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "katex": "^0.18.1",
    "lucide-react": "^1.17.0",
    "officeparser": "^7.1.0",
    "pdfjs-dist": "^6.0.227",
    "pinyin-match": "^1.2.10",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-zoom-pan-pinch": "^4.0.4",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^6.0.0-beta.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
