# 复制为 .env.local 并填入真实密钥（本地用 `vercel dev` 启动时生效）
# Vercel 部署环境请在 Vercel 控制台 → Settings → Environment Variables 中配置

# highwayapi 大模型聚合接口密钥（同时用于聊天对话和图片生成）
HIGHWAY_API_KEY=

# 博查（Bocha）联网搜索接口密钥
BOCHA_API_KEY=

# 访问码（防滥用）：留空则不开启，部署到 Vercel 公网时强烈建议设置
# 用户首次访问需输入此密码，后续请求自动通过 X-Access-Code 头携带
ACCESS_CODE=
